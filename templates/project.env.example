# 💭 DreamContainer project config — stamped by `dream new`, edit freely.
# Everything has a sane default; the only thing you MUST set is the repo.

# --- Identity ----------------------------------------------------------------
PROJECT_NAME=my-project
PROJECT_REPO=https://github.com/you/my-project.git
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- Image -------------------------------------------------------------------
# ghcr.io/ahelme/dream-container:latest         (slim default)
# ghcr.io/ahelme/dream-container:browser        (Chromium + Playwright)
DREAM_IMAGE=ghcr.io/ahelme/dream-container:latest

# --- RAM budget (docs/ARCHITECTURE.md §10) -----------------------------------
AGENT_MEM_LIMIT=3g
AGENT_MEMSWAP_LIMIT=4g
AGENT_NODE_HEAP_MB=2048
AGENT_PIDS_LIMIT=512
AGENT_CPUS=2
AGENT_SHM_SIZE=64m          # browser projects: 1g

# --- GitHub auth (token-first; see ARCHITECTURE §5) --------------------------
# Fine-grained PAT scoped to THIS project's repos only. With the credential
# proxy enabled below, put a placeholder here instead — the proxy injects
# the real token at the network boundary and this container never holds it.
GH_TOKEN=

# --- DreamTeams (optional; leave empty for solo projects) --------------------
# Teams repo (read-write) is cloned into the `team` volume by `dream new`;
# system/ops repo (read-only guardrails) into `team-system`.
TEAM_REPO=
TEAM_SYSTEM_REPO=

# --- Secrets broker (optional; ARCHITECTURE §6) ------------------------------
# Path on the HOST to the tmpfs file rendered by the host-side
# `infisical agent` for this project. Mounted read-only at
# /run/secrets/project.env and sourced at shell start.
DREAM_SECRETS_FILE=

# --- Credential proxy (optional; ARCHITECTURE §7) ----------------------------
# e.g. http://<session-token>:@agent-vault:14322
DREAM_CRED_PROXY=
DREAM_CRED_PROXY_CA=
DREAM_CRED_PROXY_NOPROXY=localhost,127.0.0.1

# --- Team chat (optional; DreamTeams transports) -----------------------------
MATTERMOST_URL=
MATTERMOST_TOKEN=
MATTERMOST_CHANNEL_ID=

# --- Network -----------------------------------------------------------------
DREAM_AGENT_NETWORK=dream-agents
DREAM_AGENT_NETWORK_EXTERNAL=false

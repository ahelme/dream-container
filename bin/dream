#!/usr/bin/env bash
# 💭 dream — provision and manage per-project Claude Code agent containers.
# VERSION: 0.1.0  (DreamContainer v2, milestone 1)
#
#   dream new <project> [--repo URL] [--browser] [--team URL] [--system URL]
#   dream fleet <team.yaml> [--team URL] [--browser] [--dry-run]
#                                  provision one agent container per team.yaml agent
#   dream ls
#   dream shell <project>          open a Claude-ready shell in the agent
#   dream claude <project>         launch Claude Code directly (team-wired)
#   dream logs <project>
#   dream up <project> | down <project> | rm <project>
#   dream refresh <project>        pull latest image + recreate (keeps volumes)
#   dream doctor                   check host prerequisites
#
# One agent container per project. State lives in named volumes, so refresh
# and image updates never cost you auth or workspace. See docs/ARCHITECTURE.md.

set -euo pipefail

DREAM_HOME="${DREAM_HOME:-$HOME/dream}"
# Resolve the repo root so templates are found whether dream is symlinked
# onto PATH or run in place.
_SRC="${BASH_SOURCE[0]}"; while [[ -L "$_SRC" ]]; do _SRC="$(readlink "$_SRC")"; done
REPO_ROOT="$(cd "$(dirname "$_SRC")/.." && pwd)"
TEMPLATES="$REPO_ROOT/templates"

c_r=$'\033[31m'; c_g=$'\033[32m'; c_b=$'\033[36m'; c_y=$'\033[33m'; c_0=$'\033[0m'
die()  { printf '%s✗ %s%s\n' "$c_r" "$*" "$c_0" >&2; exit 1; }
info() { printf '%s→ %s%s\n' "$c_b" "$*" "$c_0"; }
ok()   { printf '%s✓ %s%s\n' "$c_g" "$*" "$c_0"; }
note() { printf '%s%s%s\n' "$c_y" "$*" "$c_0"; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }
compose() { docker compose "$@"; }

project_dir() { echo "$DREAM_HOME/$1"; }
require_project() {
  local d; d="$(project_dir "$1")"
  [[ -f "$d/docker-compose.yml" ]] || die "no such project '$1' (try: dream ls)"
  echo "$d"
}

cmd_doctor() {
  local ok=1
  for t in docker git; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t present"; else note "missing: $t"; ok=0; fi
  done
  if docker compose version >/dev/null 2>&1; then ok "docker compose v2 present"; else note "missing: docker compose v2"; ok=0; fi
  if docker info >/dev/null 2>&1; then
    ok "docker daemon reachable"
    docker info 2>/dev/null | grep -qi rootless && ok "rootless docker (recommended)" || note "rootless docker NOT detected — fine, but rootless adds user-namespace isolation"
  else
    note "docker daemon not reachable"; ok=0
  fi
  [[ "$ok" == 1 ]] && ok "host looks ready" || die "host prerequisites missing (see above)"
}

cmd_new() {
  local name="${1:-}"; shift || true
  [[ -n "$name" ]] || die "usage: dream new <project> [--repo URL] [--browser] [--team URL] [--system URL]"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "project name must be lowercase alphanumeric/hyphen"

  local repo="" browser=0 team="" system=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)    repo="$2"; shift 2 ;;
      --browser) browser=1; shift ;;
      --team)    team="$2"; shift 2 ;;
      --system)  system="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done

  local d; d="$(project_dir "$name")"
  [[ -e "$d" ]] && die "project dir already exists: $d (refusing to clobber)"
  mkdir -p "$d"

  cp "$TEMPLATES/docker-compose.project.yml" "$d/docker-compose.yml"
  cp "$TEMPLATES/project.env.example" "$d/.env"

  # Seed .env values we know.
  _set_env "$d/.env" PROJECT_NAME "$name"
  [[ -n "$repo" ]]   && _set_env "$d/.env" PROJECT_REPO "$repo"
  [[ -n "$team" ]]   && _set_env "$d/.env" TEAM_REPO "$team"
  [[ -n "$system" ]] && _set_env "$d/.env" TEAM_SYSTEM_REPO "$system"
  if [[ "$browser" == 1 ]]; then
    _set_env "$d/.env" DREAM_IMAGE "ghcr.io/ahelme/dream-container:browser"
    _set_env "$d/.env" AGENT_SHM_SIZE "1g"
  fi

  ok "created $d"
  [[ "${FLEET_QUIET:-0}" == 1 ]] && return 0
  note "next:"
  note "  1. edit $d/.env — set GH_TOKEN (a fine-grained PAT scoped to this project)"
  note "     bootstrap tip: deliver it via an Infisical share link (1 view, 5 min),"
  note "     curl it on the host, never paste into shell history. (ARCHITECTURE §6)"
  note "  2. dream up $name        # start the agent"
  note "  3. dream shell $name     # hop in; run: claude"
}

# dream fleet team.yaml — the org graph provisions the whole team.
# One project per agent, named <project>-<agent>, each stamped with its
# AGENT_* identity from the YAML. team.yaml format: DreamTeams
# docs/TEAM-GRAPH-SCHEMA.md (write one with the Agents Graph configurator).
cmd_fleet() {
  local file="${1:-}"; shift || true
  [[ -f "${file:-}" ]] || die "usage: dream fleet <team.yaml> [--team URL] [--browser] [--dry-run]"
  need python3

  local team="" browser=0 dry=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --team)    team="$2"; shift 2 ;;
      --browser) browser=1; shift ;;
      --dry-run) dry=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  # Validate first when the team-graph CLI is around (it ships in DreamTeams).
  if command -v team-graph >/dev/null 2>&1; then
    team-graph validate "$file" || die "team.yaml failed validation"
  else
    note "team-graph not on PATH — provisioning without full validation"
  fi

  # Parse the org graph into tab-separated lines we can consume in bash.
  local plan
  plan="$(python3 - "$file" <<'PY'
import sys
try:
    import yaml
except ImportError:
    print("PYYAML_MISSING"); sys.exit(0)
cfg = yaml.safe_load(open(sys.argv[1])) or {}
p = cfg.get("project") or {}
print("\t".join(["project", p.get("name") or "", p.get("repo") or ""]))
for a in cfg.get("agents") or []:
    g = a.get("git") or {}
    print("\t".join(["agent", a.get("name") or "", a.get("role") or "agent",
                     a.get("permissions") or "default",
                     g.get("branch_pattern") or "", g.get("rotation") or ""]))
PY
)" || die "could not parse $file"
  [[ "$plan" == PYYAML_MISSING* ]] && die "dream fleet needs PyYAML: pip install pyyaml"

  local pname="" prepo="" prepo_url=""
  local -a rows=()
  while IFS=$'\t' read -r kind f1 f2 f3 f4 f5; do
    case "$kind" in
      project) pname="$f1"; prepo="$f2" ;;
      agent)   rows+=("$f1"$'\t'"$f2"$'\t'"$f3"$'\t'"$f4"$'\t'"$f5") ;;
    esac
  done <<< "$plan"
  [[ -n "$pname" ]] || die "team.yaml has no project.name"
  [[ ${#rows[@]} -gt 0 ]] || die "team.yaml declares no agents"
  # owner/repo shorthand → clone URL; full URLs pass through untouched
  if [[ -n "$prepo" ]]; then
    case "$prepo" in
      http*|git@*) prepo_url="$prepo" ;;
      */*)         prepo_url="https://github.com/${prepo}.git" ;;
    esac
  fi

  info "fleet: $pname — ${#rows[@]} agents$( [[ -n "$prepo_url" ]] && echo " · repo $prepo_url" )"
  local aname arole aperm abranch arot proj
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r aname arole aperm abranch arot <<< "$row"
    proj="${pname}-${aname}"
    [[ "$proj" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "bad project name '$proj' (team.yaml names must be lowercase alphanumeric/hyphen)"
    if [[ "$dry" == 1 ]]; then
      printf '  %-28s role=%-10s perms=%-9s branch=%s\n' "$proj" "$arole" "$aperm" "$abranch"
      continue
    fi
    FLEET_QUIET=1 cmd_new "$proj" \
      $( [[ -n "$prepo_url" ]] && echo --repo "$prepo_url" ) \
      $( [[ -n "$team" ]] && echo --team "$team" ) \
      $( [[ "$browser" == 1 ]] && echo --browser )
    local d; d="$(project_dir "$proj")"
    _set_env "$d/.env" AGENT_NAME "$aname"
    _set_env "$d/.env" AGENT_ROLE "$arole"
    _set_env "$d/.env" AGENT_PERMISSIONS "$aperm"
    _set_env "$d/.env" AGENT_BRANCH_PATTERN "$abranch"
  done
  [[ "$dry" == 1 ]] && { ok "dry run — nothing created"; return 0; }

  ok "fleet provisioned: ${#rows[@]} agent containers"
  note "next, for EACH agent (or script it):"
  note "  1. edit \$DREAM_HOME/${pname}-<agent>/.env — set GH_TOKEN (per-agent PAT,"
  note "     or point at the credential proxy; never share one token across agents)"
  note "  2. dream up ${pname}-<agent>"
  note "identity: containers get AGENT_NAME/ROLE/PERMISSIONS/BRANCH_PATTERN from"
  note "team.yaml — DreamTeams team-detect picks the matching chat profile."
}

# _set_env FILE KEY VALUE — replace a KEY=... line in place (portable sed).
_set_env() {
  local file="$1" key="$2" val="$3"
  if grep -qE "^${key}=" "$file"; then
    local esc; esc="$(printf '%s' "$val" | sed -e 's/[\/&]/\\&/g')"
    sed -i.bak -E "s/^${key}=.*/${key}=${esc}/" "$file" && rm -f "$file.bak"
  else
    printf '%s=%s\n' "$key" "$val" >> "$file"
  fi
}

_clone_into_volume() {
  # _clone_into_volume PROJECT VOLUME REPO [--ro-note]
  # Clones REPO into a named volume via a throwaway base container.
  local project="$1" volume="$2" repo="$3"
  [[ -n "$repo" ]] || return 0
  info "cloning $repo → volume ${project}_${volume}"
  docker run --rm \
    -v "${project}_${volume}:/dst" \
    -e REPO="$repo" \
    ghcr.io/ahelme/dream-container:latest \
    bash -c 'if [ -z "$(ls -A /dst 2>/dev/null)" ]; then git clone --depth 1 "$REPO" /dst; else echo "volume not empty, skipping clone"; fi' \
    || note "clone into $volume failed (you can clone manually later)"
}

cmd_up() {
  local d; d="$(require_project "${1:-}")"
  ( cd "$d" && compose up -d )
  # Populate workspace + team volumes on first boot.
  local name; name="$(basename "$d")"
  local repo team system
  repo="$(_get_env "$d/.env" PROJECT_REPO)"
  team="$(_get_env "$d/.env" TEAM_REPO)"
  system="$(_get_env "$d/.env" TEAM_SYSTEM_REPO)"
  [[ -n "$repo" ]]   && docker exec "${name}-agent" bash -c '[ -z "$(ls -A /workspace 2>/dev/null)" ] && git clone --depth 1 '"$repo"' /workspace || true' || true
  [[ -n "$team" ]]   && docker exec "${name}-agent" bash -c '[ -z "$(ls -A /team 2>/dev/null)" ] && git clone --depth 1 '"$team"' /team || true' || true
  [[ -n "$system" ]] && docker exec "${name}-agent" bash -c '[ -z "$(ls -A /team-system 2>/dev/null)" ] && git clone --depth 1 '"$system"' /team-system || true' || true
  ok "$name up"
}

_get_env() { grep -E "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2- || true; }

cmd_down()  { local d; d="$(require_project "${1:-}")"; ( cd "$d" && compose down ); ok "${1} down"; }
cmd_logs()  { local d; d="$(require_project "${1:-}")"; ( cd "$d" && compose logs -f ); }
cmd_shell() { local d n; d="$(require_project "${1:-}")"; n="$(basename "$d")"; exec docker exec -it "${n}-agent" zsh; }
cmd_claude(){ local d n; d="$(require_project "${1:-}")"; n="$(basename "$d")"; exec docker exec -it "${n}-agent" claude; }

cmd_refresh() {
  local d n; d="$(require_project "${1:-}")"; n="$(basename "$d")"
  info "pulling latest image + recreating $n (volumes preserved)"
  ( cd "$d" && compose pull && compose up -d )
  ok "$n refreshed"
}

cmd_rm() {
  local d n; d="$(require_project "${1:-}")"; n="$(basename "$d")"
  local purge=0
  [[ "${2:-}" == "--purge" ]] && purge=1
  ( cd "$d" && compose down $([[ "$purge" == 1 ]] && echo --volumes) )
  if [[ "$purge" == 1 ]]; then
    rm -rf "$d"; ok "$n removed (dir + volumes purged)"
    note "auth, workspace and team volumes were destroyed."
  else
    ok "$n stopped; dir + volumes kept at $d (use --purge to delete everything)"
  fi
}

cmd_ls() {
  [[ -d "$DREAM_HOME" ]] || { note "no projects yet (dream new <project>)"; return 0; }
  printf '%-24s %-10s %s\n' PROJECT STATE IMAGE
  local d name state image
  for d in "$DREAM_HOME"/*/; do
    [[ -f "$d/docker-compose.yml" ]] || continue
    name="$(basename "$d")"
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "${name}-agent"; then state="up"; else state="down"; fi
    image="$(_get_env "$d/.env" DREAM_IMAGE)"; image="${image##*:}"
    printf '%-24s %-10s %s\n' "$name" "$state" "${image:-latest}"
  done
}

main() {
  need docker
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    new)     cmd_new "$@" ;;
    fleet)   cmd_fleet "$@" ;;
    up)      cmd_up "$@" ;;
    down)    cmd_down "$@" ;;
    ls|list) cmd_ls "$@" ;;
    shell)   cmd_shell "$@" ;;
    claude)  cmd_claude "$@" ;;
    logs)    cmd_logs "$@" ;;
    refresh) cmd_refresh "$@" ;;
    rm)      cmd_rm "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    ""|-h|--help|help)
      sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (dream --help)" ;;
  esac
}
main "$@"
